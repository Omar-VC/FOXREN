rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Identidad
    // ---------------------------------------------------------------------

    // Superadmin: es el mismo UID que FOXREN_OWNER_UID en
    // src/infrastructure/firebase/adminIdentity.ts. Reemplazar el texto de abajo
    // por ese valor. Cada proyecto Firebase (desarrollo, demo, producción) tiene
    // sus propios usuarios, así que cada uno lleva su UID.
    function esSuperadmin() {
      return request.auth != null
        && request.auth.uid == "BF0KyHXXTAOOOw74ztc0clvg1XN2";
    }

    // Admin de complejo: tiene un documento usuarios/{uid} con rol "complejo",
    // activo y con su complejoId. El documento lo crea solo el superadmin.
    function perfilUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esComplejoActivo() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilUsuario().rol == "complejo"
        && perfilUsuario().activo == true
        && perfilUsuario().complejoId is string;
    }

    function esComplejoDe(complejoId) {
      return esComplejoActivo() && perfilUsuario().complejoId == complejoId;
    }

    function complejoDeTorneo(torneoId) {
      return get(/databases/$(database)/documents/torneos/$(torneoId)).data.complejoId;
    }

    // Superadmin, o el admin del complejo dueño del torneo.
    function puedeGestionarTorneo(torneoId) {
      return esSuperadmin() || esComplejoDe(complejoDeTorneo(torneoId));
    }

    // ---------------------------------------------------------------------
    // Cuentas de acceso al panel: cada usuario lee solo su propio documento.
    // ---------------------------------------------------------------------

    match /usuarios/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || esSuperadmin());
      allow write: if esSuperadmin();
    }

    // ---------------------------------------------------------------------
    // Datos PRIVADOS: solo el superadmin
    // (jugadores con DNI y fecha de nacimiento, inscripciones, historial, etc.)
    // ---------------------------------------------------------------------

    match /jugadores/{id} {
      allow read, write: if esSuperadmin();
    }

    match /inscripciones/{id} {
      allow read, write: if esSuperadmin();
    }

    match /reservas_competencia/{id} {
      allow read, write: if esSuperadmin();
    }

    match /historial/{id} {
      allow read, write: if esSuperadmin();
    }

    match /rankings/{id} {
      allow read, write: if esSuperadmin();
    }

    // ---------------------------------------------------------------------
    // Registro de jugadores: el público solo puede ENVIAR una solicitud.
    // No puede leerla, modificarla ni borrarla (tiene DNI y datos de contacto).
    // ---------------------------------------------------------------------

    match /solicitudes_registro/{id} {
      allow read, update, delete: if esSuperadmin();

      allow create: if esSuperadmin()
        || (
          request.resource.data.estado == "pendiente"
          && !("jugadorId" in request.resource.data)
          && request.resource.data.keys().size() <= 25
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() <= 100
          && request.resource.data.apellido is string
          && request.resource.data.apellido.size() <= 100
          && request.resource.data.dni is string
          && request.resource.data.dni.size() <= 20
        );
    }

    // ---------------------------------------------------------------------
    // Datos PÚBLICOS: cualquiera lee, solo el superadmin escribe.
    // ---------------------------------------------------------------------

    match /circuitos/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /complejos/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /categorias/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    // Solo nombre, contacto público y estado.
    match /organizadores/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /zonas/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /parejas/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /partidos/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /resultados/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    // Proyecciones públicas generadas por el sistema: solo campos públicos.
    match /rankings_publicos/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    match /jugadores_publicos/{id} {
      allow read: if true;
      allow write: if esSuperadmin();
    }

    // ---------------------------------------------------------------------
    // Gestionados también por el admin de SU complejo.
    // ---------------------------------------------------------------------

    match /torneos/{id} {
      allow read: if true;

      allow create: if esSuperadmin()
        || esComplejoDe(request.resource.data.complejoId);

      // Un complejo edita solo sus torneos y no puede pasarlos a otro complejo.
      allow update: if esSuperadmin()
        || (
          esComplejoDe(resource.data.complejoId)
          && request.resource.data.complejoId == resource.data.complejoId
        );

      allow delete: if esSuperadmin();
    }

    match /competencias/{id} {
      allow read: if true;

      allow create: if puedeGestionarTorneo(request.resource.data.torneoId);

      allow update: if puedeGestionarTorneo(resource.data.torneoId)
        && request.resource.data.torneoId == resource.data.torneoId;

      allow delete: if esSuperadmin();
    }

    // Padrón sin datos sensibles: el complejo lo lee para inscribir parejas.
    // El índice por DNI solo se consulta de a un documento (no se puede listar).
    match /padron_jugadores/{id} {
      allow read: if esSuperadmin() || esComplejoActivo();
      allow create, update, delete: if esSuperadmin();
    }

    match /padron_dni/{id} {
      allow get: if esSuperadmin() || esComplejoActivo();
      allow list, create, update, delete: if esSuperadmin();
    }

    // Todo lo que no figura arriba queda cerrado.
  }
}
